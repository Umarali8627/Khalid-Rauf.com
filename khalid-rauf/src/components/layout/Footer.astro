---
const year = new Date().getFullYear();

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Books', href: '/books' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
];

const resources = [
  { label: 'Campaign', href: '/campaign' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms of Use', href: '/terms' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <p class="footer__brand">Khalid Rauf</p>
        <p class="footer__desc">
          Writer, poet, thinker, and leader — exploring the intersections of
          literature, politics, philosophy, and society.
        </p>
        <div class="footer__social">
          <a href="#" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
          </a>
          <a href="#" aria-label="Twitter / X">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2h3.3l-7.2 8.2L23.4 22h-6.7l-5.2-6.9L5.6 22H2.3l7.7-8.8L1.6 2h6.9l4.7 6.3L18.9 2z"/></svg>
          </a>
          <a href="#" aria-label="YouTube">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.5v-7l6.3 3.5z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="footer__heading">Quick Links</h4>
        <ul class="footer__links">
          {quickLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="footer__heading">Resources</h4>
        <ul class="footer__links">
          {resources.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__newsletter">
        <h4 class="footer__heading">Stay Updated</h4>
        <p>Get new articles, poems, and book releases in your inbox.</p>
        <form class="footer__form">
          <input type="email" placeholder="Your email" required />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} Khalid Rauf Qureshi. All rights reserved.</p>
      <div class="footer__legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>
