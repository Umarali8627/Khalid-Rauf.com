---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import '../styles/pages/checkout.css';
---

<MainLayout title="Checkout" description="Complete your purchase.">
  <PageHero eyebrow="Almost There" title="Checkout" breadcrumb="Checkout" />

  <section class="section">
    <div class="container">
      <div id="checkoutContainer">
        <p class="text-center">Loading your order…</p>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { getCart, selectShippingRate, submitCheckout } from '../lib/cart-client';

  const countries = [
    { code: 'US', name: 'United States' },
    { code: 'CA', name: 'Canada' },
    { code: 'GB', name: 'United Kingdom' },
    { code: 'PK', name: 'Pakistan' },
    { code: 'AE', name: 'United Arab Emirates' },
  ];

  async function render() {
    const container = document.getElementById('checkoutContainer')!;
    const cart = await getCart();

    if (!cart || cart.items.length === 0) {
      container.innerHTML = `
        <div class="cart-empty">
          <p>Your cart is empty.</p>
          <a href="/books" class="btn btn--primary" style="margin-top: 1rem;">Browse Books</a>
        </div>
      `;
      return;
    }

    const shippingPackage = cart.shipping_rates?.[0];
    const shippingOptionsHtml = shippingPackage
      ? shippingPackage.shipping_rates
          .map((rate) => {
            const minor = cart.totals.currency_minor_unit ?? 2;
            const price = (Number(rate.price) / 10 ** minor).toFixed(minor);
            return `
              <label class="shipping-option ${rate.selected ? 'selected' : ''}" data-rate-id="${rate.rate_id}">
                <input type="radio" name="shipping" value="${rate.rate_id}" ${rate.selected ? 'checked' : ''} />
                <span style="flex:1;">${rate.name}</span>
                <span>${cart.totals.currency_symbol}${price}</span>
              </label>
            `;
          })
          .join('')
      : '<p>Enter your address to see shipping options.</p>';

    const itemsHtml = cart.items
      .map((item) => {
        const image = item.images?.[0]?.src ?? '/placeholder-book.jpg';
        return `
          <div class="order-summary__item">
            <img src="${image}" alt="${item.name}" referrerpolicy="no-referrer" />
            <div class="order-summary__item-info">
              <h5>${item.name}</h5>
              <p>Qty: ${item.quantity}</p>
            </div>
          </div>
        `;
      })
      .join('');

    const minorTotal = cart.totals.currency_minor_unit ?? 2;
    const total = (Number(cart.totals.total_price) / 10 ** minorTotal).toFixed(minorTotal);
    const countryOptions = countries.map((c) => `<option value="${c.code}">${c.name}</option>`).join('');

    container.innerHTML = `
      <form id="checkoutForm" class="checkout-grid">
        <div>
          <div class="checkout-form-section">
            <h3>Contact & Shipping Address</h3>
            <div class="form-group">
              <label>Email</label>
              <input type="email" name="email" required />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>First Name</label>
                <input type="text" name="first_name" required />
              </div>
              <div class="form-group">
                <label>Last Name</label>
                <input type="text" name="last_name" required />
              </div>
            </div>
            <div class="form-group">
              <label>Address</label>
              <input type="text" name="address_1" required />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>City</label>
                <input type="text" name="city" required />
              </div>
              <div class="form-group">
                <label>State / Province</label>
                <input type="text" name="state" required />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Postal Code</label>
                <input type="text" name="postcode" required />
              </div>
              <div class="form-group">
                <label>Country</label>
                <select name="country" required>${countryOptions}</select>
              </div>
            </div>
            <div class="form-group">
              <label>Phone</label>
              <input type="tel" name="phone" required />
            </div>
          </div>

          <div class="checkout-form-section">
            <h3>Shipping Method</h3>
            <div id="shippingOptions">${shippingOptionsHtml}</div>
          </div>

          <div class="checkout-form-section">
            <h3>Payment Method</h3>
            <label class="payment-option selected" data-method="cod">
              <input type="radio" name="payment_method" value="cod" checked />
              <div class="payment-option__info">
                <strong>Cash on Delivery</strong>
                <p>Pay with cash when your order arrives.</p>
              </div>
            </label>
            <label class="payment-option" data-method="paypal">
              <input type="radio" name="payment_method" value="paypal" />
              <div class="payment-option__info">
                <strong>PayPal</strong>
                <p>Pay securely online — you'll be redirected to PayPal.</p>
              </div>
            </label>
          </div>
        </div>

        <div class="order-summary">
          <h3 style="margin-bottom: 1rem;">Order Summary</h3>
          ${itemsHtml}
          <div class="order-summary__row total">
            <span>Total</span>
            <span>${cart.totals.currency_symbol}${total}</span>
          </div>
          <button type="submit" class="btn btn--gold btn--full" style="margin-top: 1rem;" id="checkoutSubmit">
            Place Order
          </button>
          <p id="checkoutError" style="color: var(--color-error); font-size: 0.85rem; margin-top: 8px;"></p>
        </div>
      </form>
    `;

    // Shipping rate selection
    document.querySelectorAll('.shipping-option').forEach((el) => {
      el.addEventListener('click', async () => {
        const rateId = el.getAttribute('data-rate-id')!;
        document.querySelectorAll('.shipping-option').forEach((o) => o.classList.remove('selected'));
        el.classList.add('selected');
        await selectShippingRate(0, rateId);
      });
    });

    // Payment method selection — updates button label and visual state
    const submitBtn = document.getElementById('checkoutSubmit') as HTMLButtonElement;

    document.querySelectorAll('.payment-option').forEach((el) => {
      el.addEventListener('click', () => {
        document.querySelectorAll('.payment-option').forEach((o) => o.classList.remove('selected'));
        el.classList.add('selected');

        const input = el.querySelector('input[type="radio"]') as HTMLInputElement;
        input.checked = true;

        const method = el.getAttribute('data-method');
        submitBtn.textContent = method === 'paypal' ? 'Continue to PayPal' : 'Place Order';
      });
    });

    const form = document.getElementById('checkoutForm') as HTMLFormElement;
    const errorEl = document.getElementById('checkoutError') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Processing…';
      errorEl.textContent = '';

      const formData = new FormData(form);
      const paymentMethod = formData.get('payment_method') as 'paypal' | 'cod';

      const address = {
        first_name: formData.get('first_name') as string,
        last_name: formData.get('last_name') as string,
        address_1: formData.get('address_1') as string,
        city: formData.get('city') as string,
        state: formData.get('state') as string,
        postcode: formData.get('postcode') as string,
        country: formData.get('country') as string,
        email: formData.get('email') as string,
        phone: formData.get('phone') as string,
      };

      const result = await submitCheckout(address, address, paymentMethod);

      if (result.success && paymentMethod === 'paypal' && result.redirectUrl) {
        // PayPal: send the user off-site to complete payment
        window.location.href = result.redirectUrl;
      } else if (result.success && paymentMethod === 'cod') {
        // COD: order is placed immediately, no redirect needed — go to a thank-you page
        window.location.href = `/order-confirmation?order=${result.orderId ?? ''}`;
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        errorEl.textContent = result.message || 'Checkout failed. Please check your details and try again.';
      }
    });
  }
  

  render();
</script>