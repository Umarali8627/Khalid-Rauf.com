---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import '../styles/pages/confirmation.css';

const orderId = Astro.url.searchParams.get('order');
const hasOrderId = orderId && orderId.trim().length > 0;
---

<MainLayout title="Order Confirmed" description="Your order has been placed successfully.">
  <section class="section">
    <div class="container">
      <div class="confirmation">
        <div class="confirmation__icon">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 6L9 17l-5-5"></path>
          </svg>
        </div>

        <h1>Order Placed Successfully</h1>

        <p>
          Thank you for your order
          {hasOrderId && (
            <Fragment> — your order number is <span class="confirmation__order-id">#{orderId}</span></Fragment>
          )}.
          You'll receive a confirmation email shortly, and your books will be
          shipped to your address. You can pay in cash when your order arrives.
        </p>

        <Button href="/books" variant="primary">Continue Browsing</Button>
      </div>
    </div>
  </section>
</MainLayout>